<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org" name="ur3e_with_eoat">

  <!-- 1. Include the official UR macro -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <!-- Declare arguments required by ur_macro -->
  <xacro:arg name="ur_type" default="ur3e"/>
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>

  <!-- World link -->
  <link name="world"/>

  <!-- 2. Instantiate the UR3e robot arm -->
  <xacro:ur_robot
    name="ur3e"
    tf_prefix=""
    parent="world"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- 3. Define the Static EOAT Link (e.g., a 15cm cylindrical probe/spindle) -->
  <link name="static_eoat_link">
    <visual>
      <!-- Shift cylinder by half its length (0.075m) so its base sits at tool0 -->
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.15"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <!-- Make collision geometry slightly larger than visual for safety -->
        <cylinder radius="0.022" length="0.152"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- 4. Attach EOAT to the UR3e tool flange (tool0) -->
  <joint name="tool0_to_eoat" type="fixed">
    <parent link="tool0"/>
    <child link="static_eoat_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 5. Define a Tool Center Point (TCP) frame at the tip of the tool -->
  <link name="tcp_link"/>
  <joint name="eoat_to_tcp" type="fixed">
    <parent link="static_eoat_link"/>
    <child link="tcp_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

</robot>
